# Copy to .env.local. Never commit the filled-in version.

# ---- LLM (rationale rendering only, never the verdict) -------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- Base ----------------------------------------------------------
# Any archive-capable Base mainnet RPC. Alchemy, QuickNode and Chainstack
# all have free tiers that are enough for the indexer.
BASE_RPC_URL=https://...
BASE_CHAIN_ID=8453

# Contracts (Base mainnet, do not change)
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ACP_CORE=0x238E541BfefD82238730D00a2208E5497F1832E0

# Key used only to publish attestations. Fund it with a few dollars of ETH
# on Base. Never reuse a wallet that holds anything you care about.
CAIRN_ATTESTOR_KEY=
# Set once the attestation contract is deployed:
#   python scripts/publish_attestation.py --deploy
CAIRN_ATTESTATION_CONTRACT=

# ---- Sibyl Memory --------------------------------------------------
# Must sit on a persistent disk. On Fly.io this is the mounted volume.
SIBYL_DB=/data/memory.db

# ---- Virtuals ACP --------------------------------------------------
# The CLI keeps its own credentials in the OS keychain. This is only the
# public address so the agent can recognise its own jobs.
ACP_AGENT_ADDRESS=

# ---- Infra ---------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/cairn
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origin the web app serves from in development. Production uses the
# usecairn.xyz subdomains and ignores this.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
